{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-11 00:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Leave Application",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<html>\n    <style>\n        .lasign-container { font-family: Arial, sans-serif; }\n        .lasign-header { text-align: center; margin-bottom: 12px; }\n        .lasign-header img { max-height: 60px; }\n        .lasign-title { font-weight: bold; font-size: 20px; margin: 8px 0 2px; }\n        .lasign-title .ar { display: block; font-size: 18px; margin-top: 2px; }\n        table.lasign-table { width: 100%; border: 1px solid black; border-collapse: collapse; margin-bottom: 14px; }\n        table.lasign-table td, table.lasign-table th { border: 1px solid black; padding: 6px 10px; font-size: 14px; vertical-align: top; }\n        table.lasign-table th { background-color: #f2f2f2; text-align: left; width: 35%; }\n        .rtl th { text-align: right; }\n        .rtl { direction: rtl; }\n        .lasign-section-heading { font-weight: bold; font-size: 15px; margin: 14px 0 6px; }\n        .lasign-section-heading .ar { font-weight: bold; }\n        .lasign-declaration { font-size: 14px; line-height: 1.6; }\n        span.fill { text-decoration: underline; text-decoration-style: dotted; }\n\n        table.lasign-wrap { width: 100%; border: none; border-collapse: collapse; }\n        table.lasign-wrap > tbody > tr > td.lasign-col-en,\n        table.lasign-wrap > tbody > tr > td.lasign-col-ar {\n            border: none;\n            vertical-align: top;\n        }\n\n        /* Only affects the live browser \"Document Signing Preview\" modal - PDF\n           generation renders at a fixed desktop-width viewport and never\n           triggers this, so the signed PDF always uses the table-cell layout\n           above, which is what renders reliably (unlike float/div layouts,\n           which have shown RTL/bidi text overlap issues in PDF generation). */\n        @media (max-width: 600px) {\n            table.lasign-wrap > tbody > tr > td.lasign-col-en,\n            table.lasign-wrap > tbody > tr > td.lasign-col-ar {\n                display: block !important;\n                width: 100% !important;\n                padding: 0 !important;\n            }\n        }\n    </style>\n    <body>\n        <div class=\"lasign-container\">\n            <div class=\"lasign-header\">\n                <img src=\"/files/one_fm.jpg\" alt=\"Company Logo\">\n                <div class=\"lasign-title\">\n                    Leave Application\n                    <span class=\"ar\">طلب إجازة</span>\n                </div>\n            </div>\n\n            <div class=\"lasign-section-heading\">\n                Applicant Details <span class=\"ar\">بيانات مقدم الطلب</span>\n            </div>\n            <table class=\"lasign-wrap\">\n                <tr>\n                    <td class=\"lasign-col-en\" style=\"width:50%; padding-right:8px;\">\n                        <table class=\"lasign-table\">\n                            <tr><th>Employee Name</th><td><span class=\"fill\">{{ doc.employee_name }}</span></td></tr>\n                            <tr><th>Employee ID</th><td><span class=\"fill\">{{ doc.employee }}</span></td></tr>\n                            <tr><th>Department</th><td><span class=\"fill\">{{ doc.department or '' }}</span></td></tr>\n                            <tr><th>Company</th><td><span class=\"fill\">{{ doc.company }}</span></td></tr>\n                        </table>\n                    </td>\n                    <td class=\"lasign-col-ar rtl\" style=\"width:50%; padding-left:8px;\">\n                        <table class=\"lasign-table\" dir=\"rtl\">\n                            <tr><th>اسم الموظف</th><td><span class=\"fill\">{{ doc.employee_name }}</span></td></tr>\n                            <tr><th>الرقم الوظيفي</th><td><span class=\"fill\">{{ doc.employee }}</span></td></tr>\n                            <tr><th>القسم</th><td><span class=\"fill\">{{ doc.department or '' }}</span></td></tr>\n                            <tr><th>الشركة</th><td><span class=\"fill\">{{ doc.company }}</span></td></tr>\n                        </table>\n                    </td>\n                </tr>\n            </table>\n\n            <table class=\"lasign-wrap\">\n                <tr>\n                    <td class=\"lasign-col-en\" style=\"width:50%; padding-right:8px;\">\n                        <table class=\"lasign-table\">\n                            <tr><th>Leave Type</th><td><span class=\"fill\">{{ doc.leave_type }}</span></td></tr>\n                            <tr><th>From Date</th><td><span class=\"fill\">{{ frappe.utils.formatdate(doc.from_date, 'dd MMM YYYY') }}</span></td></tr>\n                            <tr><th>To Date</th><td><span class=\"fill\">{{ frappe.utils.formatdate(doc.to_date, 'dd MMM YYYY') }}</span></td></tr>\n                            <tr><th>Total Leave Days</th><td><span class=\"fill\">{{ doc.total_leave_days }}</span></td></tr>\n                            {% if doc.resumption_date %}\n                            <tr><th>Resumption Date</th><td><span class=\"fill\">{{ frappe.utils.formatdate(doc.resumption_date, 'dd MMM YYYY') }}</span></td></tr>\n                            {% endif %}\n                            <tr><th>Reason</th><td><span class=\"fill\">{{ doc.description or '' }}</span></td></tr>\n                        </table>\n                    </td>\n                    <td class=\"lasign-col-ar rtl\" style=\"width:50%; padding-left:8px;\">\n                        <table class=\"lasign-table\" dir=\"rtl\">\n                            <tr><th>نوع الإجازة</th><td><span class=\"fill\">{{ doc.leave_type }}</span></td></tr>\n                            <tr><th>من تاريخ</th><td><span class=\"fill\">{{ frappe.utils.formatdate(doc.from_date, 'dd MMM YYYY') }}</span></td></tr>\n                            <tr><th>إلى تاريخ</th><td><span class=\"fill\">{{ frappe.utils.formatdate(doc.to_date, 'dd MMM YYYY') }}</span></td></tr>\n                            <tr><th>إجمالي أيام الإجازة</th><td><span class=\"fill\">{{ doc.total_leave_days }}</span></td></tr>\n                            {% if doc.resumption_date %}\n                            <tr><th>تاريخ استئناف العمل</th><td><span class=\"fill\">{{ frappe.utils.formatdate(doc.resumption_date, 'dd MMM YYYY') }}</span></td></tr>\n                            {% endif %}\n                            <tr><th>السبب</th><td><span class=\"fill\">{{ doc.description or '' }}</span></td></tr>\n                        </table>\n                    </td>\n                </tr>\n            </table>\n\n            {% set signer = frappe.db.get_value('Employee', {'user_id': frappe.session.user}, ['employee_name', 'one_fm_civil_id'], as_dict=1) %}\n\n            <div class=\"lasign-section-heading\">\n                Approver / Signee Details <span class=\"ar\">بيانات المعتمد / الموقّع</span>\n            </div>\n            <table class=\"lasign-wrap\">\n                <tr>\n                    <td class=\"lasign-col-en\" style=\"width:50%; padding-right:8px;\">\n                        <table class=\"lasign-table\">\n                            <tr><th>Approver Name</th><td><span class=\"fill\">{{ signer.employee_name if signer else doc.leave_approver_name }}</span></td></tr>\n                            <tr><th>Civil ID</th><td><span class=\"fill\">{{ signer.one_fm_civil_id if signer else '' }}</span></td></tr>\n                        </table>\n                    </td>\n                    <td class=\"lasign-col-ar rtl\" style=\"width:50%; padding-left:8px;\">\n                        <table class=\"lasign-table\" dir=\"rtl\">\n                            <tr><th>اسم المعتمد</th><td><span class=\"fill\">{{ signer.employee_name if signer else doc.leave_approver_name }}</span></td></tr>\n                            <tr><th>الرقم المدني</th><td><span class=\"fill\">{{ signer.one_fm_civil_id if signer else '' }}</span></td></tr>\n                        </table>\n                    </td>\n                </tr>\n            </table>\n\n            <table class=\"lasign-wrap\">\n                <tr>\n                    <td class=\"lasign-col-en\" style=\"width:50%; padding-right:8px;\">\n                        <div class=\"lasign-declaration\">\n                            I, <span class=\"fill\">{{ signer.employee_name if signer else doc.leave_approver_name }}</span>, holding Civil ID No. (<span class=\"fill\">{{ signer.one_fm_civil_id if signer else '' }}</span>), acting as approver, hereby attest that I have reviewed the leave request submitted by <span class=\"fill\">{{ doc.employee_name }}</span> as detailed above, and that the details stated are, to the best of my knowledge, true and accurate.\n                            <br><br>\n                            I authorize <span class=\"fill\">{{ doc.company }}</span> to adopt my digital signature affixed to this document as a legally valid and binding electronic signature attesting to my approval of this leave request.\n                        </div>\n                    </td>\n                    <td class=\"lasign-col-ar rtl\" style=\"width:50%; padding-left:8px;\">\n                        <div class=\"lasign-declaration\">\n                            أنا، <span class=\"fill\">{{ signer.employee_name if signer else doc.leave_approver_name }}</span>، حامل الرقم المدني رقم (<span class=\"fill\">{{ signer.one_fm_civil_id if signer else '' }}</span>)، وبصفتي المعتمد، أقر بأنني اطلعت على طلب الإجازة المقدم من <span class=\"fill\">{{ doc.employee_name }}</span> المذكور أعلاه، وأن البيانات الواردة فيه صحيحة ودقيقة بحسب علمي.\n                            <br><br>\n                            وأفوض شركة <span class=\"fill\">{{ doc.company }}</span> باعتماد توقيعي الإلكتروني الموقع على هذا المستند كتوقيع إلكتروني صالح وملزم قانونًا يثبت موافقتي على طلب الإجازة هذا.\n                        </div>\n                    </td>\n                </tr>\n            </table>\n\n            <table class=\"lasign-wrap\" style=\"margin-top: 16px;\">\n                <tr>\n                    <td class=\"lasign-col-en\" style=\"width:50%;\">Date: {{ frappe.utils.formatdate(doc.posting_date, 'dd MMM YYYY') }}</td>\n                    <td class=\"lasign-col-ar rtl\" style=\"width:50%;\">التاريخ: {{ frappe.utils.formatdate(doc.posting_date, 'dd MMM YYYY') }}</td>\n                </tr>\n            </table>\n        </div>\n    </body>\n</html>\n",
 "idx": 0,
