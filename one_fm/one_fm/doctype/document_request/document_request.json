 "fields": [
  {
   "fieldname": "requester",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Requester",
   "options": "Employee",
   "reqd": 1,
   "description": "The employee raising this documentation request."
  },
  {
   "fieldname": "requester_user",
   "fieldtype": "Link",
   "fetch_from": "requester.user_id",
   "label": "Requester User",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "column_break_request",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "request_action",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Action",
   "options": "Create\nUpdate\nDelete",
   "default": "Create",
   "reqd": 1,
   "description": "Create a new document, revise the content of an existing one, or remove an existing one from Drive."
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Document Type",
   "options": "Policy\nSOP\nGuideline\nManual\nAI Knowledge Document",
   "reqd": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "mandatory_depends_on": "eval:doc.request_action != 'Delete'",
   "description": "Proposed title for the document being requested."
  },
  {
   "fieldname": "requirement_text",
   "fieldtype": "Small Text",
   "label": "Requirement",
   "mandatory_depends_on": "eval:doc.request_action != 'Delete'",
   "description": "What's needed and why — this becomes the AI drafting requirement in Processa."
  },
  {
   "fieldname": "source_guideline",
   "fieldtype": "Link",
   "label": "Source Guideline",
   "options": "AI Reference Index",
   "mandatory_depends_on": "eval:doc.request_action == 'Create'",
   "description": "The existing guideline document (already cataloged in AI Reference Index) this document should be generated from. Its real content is extracted and given to the AI — the AI does not invent the guideline itself."
  },
  {
   "fieldname": "reference_document",
   "fieldtype": "Link",
   "label": "Existing Document",
   "options": "AI Reference Index",
   "depends_on": "eval:doc.request_action != 'Create'",
   "mandatory_depends_on": "eval:doc.request_action != 'Create'",
   "description": "The existing published document (from the AI Reference Index catalog) being updated or deleted."
  },
  {
   "fieldname": "section_break_approval",
   "fieldtype": "Section Break",
   "label": "Approval"
  },
  {
   "fieldname": "approver",
   "fieldtype": "Link",
   "fetch_from": "requester.reports_to",
   "in_list_view": 1,
   "label": "Approver",
   "options": "Employee",
   "read_only": 1,
   "description": "Always the requester's line manager (Employee > Reports To) — not chosen manually."
  },
  {
   "fieldname": "approver_user",
   "fieldtype": "Link",
   "fetch_from": "approver.user_id",
   "label": "Approver User",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "column_break_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Pending Request Approval\nRequest Rejected\nDrafting\nPending Content Approval\nContent Rejected\nApproved\nPublished\nDeleted",
   "default": "Pending Request Approval",
   "read_only": 1
  },
  {
   "fieldname": "bpmn_instance",
   "fieldtype": "Link",
   "label": "BPMN Process Instance",
   "options": "BPMN Process Instance",
   "read_only": 1,
   "description": "The Processa instance running this request through Creation → Review → Approval → Publish."
  }
 ],
