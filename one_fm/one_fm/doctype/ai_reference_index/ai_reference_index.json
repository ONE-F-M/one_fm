 "fields": [
  {
   "fieldname": "drive_file_id",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Drive File ID",
   "reqd": 1,
   "unique": 1,
   "description": "The Google Drive file id this index entry mirrors. One entry per Drive file — re-indexing updates the same record rather than creating a duplicate."
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Document Type"
  },
  {
   "fieldname": "drive_file_link",
   "fieldtype": "Data",
   "label": "Drive File Link"
  },
  {
   "fieldname": "source_process",
   "fieldtype": "Data",
   "label": "Source Process",
   "description": "Which BPMN process produced/published this document, e.g. 'SOP Generation from Guidelines'."
  },
  {
   "fieldname": "document_code",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Document Code",
   "read_only": 1,
   "unique": 1,
   "description": "Readable, citable identifier allocated at first publish — POL-0001, SOP-0004. The Drive file id is the real key; this exists because nobody cites a 44-character id in a meeting."
  },
  {
   "fieldname": "column_break_lifecycle",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "lifecycle_state",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Lifecycle State",
   "options": "Active\nInactive",
   "default": "Active",
   "read_only": 1,
   "description": "Inactive means withdrawn from use, not destroyed: the Drive file and every version snapshot are kept, and sharing is revoked so it stops appearing to staff. Reversible from the Reactivate button."
  },
  {
   "fieldname": "current_version",
   "fieldtype": "Int",
   "in_list_view": 1,
   "label": "Current Version",
   "read_only": 1,
   "default": "0",
   "description": "Which revision the Drive file currently holds. Incremented once per publish; 0 means nothing has been published yet."
  },
  {
   "fieldname": "section_break_deactivation",
   "fieldtype": "Section Break",
   "label": "Deactivation",
   "depends_on": "eval:doc.lifecycle_state == \"Inactive\""
  },
  {
   "fieldname": "deactivated_on",
   "fieldtype": "Datetime",
   "label": "Deactivated On",
   "read_only": 1
  },
  {
   "fieldname": "deactivated_by",
   "fieldtype": "Link",
   "label": "Deactivated By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "column_break_deactivation",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "deactivated_via_request",
   "fieldtype": "Link",
   "label": "Deactivated Via Request",
   "options": "Document Request",
   "read_only": 1
  },
  {
   "fieldname": "deactivation_reason",
   "fieldtype": "Small Text",
   "label": "Deactivation Reason",
   "read_only": 1,
   "description": "Why it was withdrawn — taken from the requirement text on the request that withdrew it."
  },
  {
   "fieldname": "section_break_content",
   "fieldtype": "Section Break",
   "label": "Current Content"
  },
  {
   "fieldname": "content",
   "fieldtype": "Long Text",
   "label": "Indexed Content",
   "description": "Plain-text/Markdown of the CURRENT version, used for keyword matching by Gather Reference-style Script Tasks. Superseded text lives on AI Document Version, not here. Not a semantic/vector index — see AI integration notes."
  }
 ],
